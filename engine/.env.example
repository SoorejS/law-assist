# ── LLM Backend ───────────────────────────────────────────────────────────────
# Options: local | sarvam | anthropic
# "local"     → uses the GGUF model at LOCAL_MODEL_PATH (offline, zero cost)
# "sarvam"    → uses Sarvam Pravah API (Indian sovereign cloud)
# "anthropic" → uses Claude (English-heavy complex queries only)
LLM_BACKEND=local

# ── Local model ────────────────────────────────────────────────────────────────
# Path to your downloaded GGUF file.
# Recommended: Qwen2.5-1.5B-Instruct-Q4_K_M.gguf (fast, ~1GB)
# Or:          Sarvam-1-Q4_K_M.gguf (Tamil/Indian languages)
# LOCAL_MODEL_PATH=models/model.gguf

# ── Sarvam API (Pravah) ────────────────────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-m

# ── Anthropic (premium fallback) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Industry vertical ─────────────────────────────────────────────────────────
# Options: law_firm | ca_firm | generic
SARAVONIX_VERTICAL=law_firm

# ── Retrieval tuning ───────────────────────────────────────────────────────────
TOP_K=6
SIMILARITY_THRESHOLD=1.0

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8765
